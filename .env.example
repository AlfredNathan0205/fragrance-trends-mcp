# Safe default. Fixture mode makes no external vendor calls.
FTM_MODE=fixture

# Required only after licensed mode has been implemented and approved.
# FTM_API_KEY=ftm_replace_me

# --- Streamable HTTP transport (see docs/HOSTING.md) ---
# Provision at least one licensee key, or tool traffic returns 503.
# Only the SHA-256 hash is retained at runtime.
# FTM_EVALUATION_KEY=ftm_replace_me

# General form, for multiple licensees on different plans.
# FTM_HTTP_TENANTS=[{"name":"acme","tier":"standard","key":"ftm_replace_me"}]

