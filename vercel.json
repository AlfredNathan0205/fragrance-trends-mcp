{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "headers": [
    {
      "source": "/api/mcp",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    }
  ]
}
